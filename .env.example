# Always & Furever Donor CRM — environment configuration
# Copy to ".env" and fill in real values. NEVER commit the real .env.
# Load it before launching, e.g.:  set -a; . ./.env; set +a

# REQUIRED in production. Generate a strong random key:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-64-char-random-hex-string

# Set to 1 ONLY when running behind an HTTPS reverse proxy (nginx/Caddy)
# that sets X-Forwarded-Proto / X-Forwarded-For. Enables ProxyFix so
# secure cookies and client IPs work correctly.
CRM_BEHIND_PROXY=1

# Leave UNSET in production. Set to 1 only for local HTTP testing without
# TLS, which drops the Secure flag on cookies. Never use on the web.
# CRM_INSECURE_COOKIES=1

# Leave UNSET in production. The Flask debugger is a remote-code-execution
# risk if exposed. Only set to 1 for local debugging.
# FLASK_DEBUG=1

# Optional: override the demo admin password used by seed_demo.py.
# SEED_ADMIN_PASSWORD=change-me
